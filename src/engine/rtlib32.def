; Functions our modules import from the original engine runtime (Rtlib32.dll).
; Names are exported undecorated. The @N suffix tells the linker that the function
; is stdcall (it removes N bytes of arguments itself); dlltool -k strips it again.
LIBRARY Rtlib32.dll
EXPORTS
    ResReadResourceData@20
    ima2pcm@20
    AudioSetServiceProc@12
    DebugStr
    RtGetDC
    RtGetDisplayMode
    RtGetHAL
    RtGetHResfile
    RtGetGameInfo
    RtGetHSL
    RtGetResource
    RtGetString
    RtGetWindow
    RtPostMsg
    RtRestoreFromGDISurface
    RtRunMsg
    RtSetDisplayMode
    RtSetGameInfo
    RtShowGDISurface
    SpriteCreateDirectDrawPalette@4
    SpriteCreateDirectDrawSurfaces@4
    SpriteDibColorMapMerge@40
    SpriteDibMerge@32
    SpriteDibSet@24
    SpriteGetDDraw@4
    SpritePaintRect@12
    SpriteRealizePalette2@8
    SpriteReleaseDirectDrawPalette@4
    SpriteReleaseDirectDrawSurfaces@4
    RtCopy
    RtDelete
    RtLoad
    SpriteEmptyQueue@8
    SpriteHide@12
    SpritePostMessage@16
    SpriteSendMessage@16
    SpriteSetLevel@12
    SpriteSetProcessMsgs
    RtRegisterCursorSprite
    RtSetScrollBox
    SpriteGetScrollPos@8
    SpriteScroll@16
    SpriteShow@16
    RtCaptureFrame
    RtFadeIn
    RtGetVar
    RtSetPos
    SpriteSetBlitFX@12
    SpriteSetSync@8
    RtUnload
    SpriteGetBounds@12
    SpriteRefreshInterfaceArea@8
    SpriteRefreshRect@8
    SpriteSetScrollPos@12
    RtGetResType
    SpriteReplaceCellRange@24
    SpriteSetExtOffsets@12
    SpriteSetPosition@20
    winmalloc@8
