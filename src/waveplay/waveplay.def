; Same export names and ordinals as the original WAVEPLAY.R32
LIBRARY WAVEPLAY.R32
EXPORTS
    RtLibInit @1
    RtLibFree @2
    DSLoadWave @3
    DSUnloadWave @4
    DSPlayWave @5
    DSStopWave @6
    DSStopWaveIdx @7
    DSGetVolume @8
    DSGetVolumeIdx @9
    DSSetVolume @10
    DSSetVolumeIdx @11
    DSGetPan @12
    DSGetPanIdx @13
    DSSetPan @14
    DSSetPanIdx @15
    DSGetFormatPrimary @16
    DSSetFormatPrimary @17
    DSGetFormat @18
    DSGetFrequency @19
    DSGetFrequencyIdx @20
    DSSetFrequency @21
    DSSetFrequencyIdx @22
    DSGetMaxBuffers @23
    DSSetMaxBuffers @24
    DSAudioService=DSAudioService@4 @25
    DSGetObject @26
    DSPauseAudio @27
    DSInitWavePlay @28
    DSDeInitWavePlay @29
    DSLoadWaveFile @30
    DSUnloadWaveFile @31
    DSPlayWaveFile @32
    DSCheckCDIdentity @33
    DSPlayCDTrack @34
    DSStopCDTrack @35
    DSNumCDTracks @36
    DSCDTrackLen @37
    DSSetCDVolume @38
    DSGetCDVolume @39
    _LoadWaveFile @40
    DSPauseCDTrack @41
    rdfInitWavePlay @42
    rdfDeInitWavePlay @43
    rdfLoadWaveFile @44
    rdfPlayWaveFile @45
    rdfUnloadWaveFile @46
    rdfPlayWave @47
    calc_crc32 @48
    "?rdfLoadWave@@YAHPAXPADH@Z"=rdfLoadWave @49
    "?rdfStopWave@@YAIPAXPAD@Z"=rdfStopWave @50
    "?rdfUnloadAll@@YAIPAX@Z"=rdfUnloadAll @51
    "?rdfUnloadWave@@YAIPAXPAD@Z"=rdfUnloadWave @52
    rdfStopAll @53
    rdfStopWaveFile @54
    rdfStopWaveIdx @55
